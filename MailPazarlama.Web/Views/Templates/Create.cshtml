@model MailTemplateCreateDto
@{
    ViewData["Title"] = "Yeni Şablon Ekle";
}

<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet" />
<style>
    .note-editor.note-frame {
        border-color: #dee2e6;
        border-radius: 0.375rem;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title mb-4">Yeni Şablon Oluştur</h3>

                <form asp-action="Create" method="post" id="templateForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Şablon Başlığı</label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: Haftalık Kampanya Bülteni #1" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContentHtml" class="form-label fw-bold">E-Posta İçeriği (Görsel HTML Editörü)</label>
                        <textarea asp-for="ContentHtml" id="contentEditor" class="form-control"></textarea>
                        <span asp-validation-for="ContentHtml" class="text-danger small"></span>
                        <div class="form-text">Metni biçimlendirebilir, başlık ekleyebilir veya kaynak HTML kodunu düzenleyebilirsiniz.</div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary px-4">Şablonu Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#contentEditor').summernote({
                placeholder: 'E-posta şablon içeriğinizi buraya yazınız...',
                tabsize: 2,
                height: 280,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline', 'clear']],
                    ['color', ['color']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['table', ['table']],
                    ['insert', ['link', 'hr']],
                    ['view', ['fullscreen', 'codeview', 'help']]
                ]
            });

            // Form gönderilirken editör boşsa textarea'yı temizle ki [Required] validasyonu çalışsın
            $('#templateForm').on('submit', function () {
                if ($('#contentEditor').summernote('isEmpty')) {
                    $('#contentEditor').val('');
                }
            });
        });
    </script>
}
