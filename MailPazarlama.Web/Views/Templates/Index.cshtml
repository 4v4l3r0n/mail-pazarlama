@model IReadOnlyList<MailTemplateDto>
@{
    ViewData["Title"] = "Şablon Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">E-Posta Şablonları</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Şablon Ekle</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#</th>
                        <th>Şablon Başlığı</th>
                        <th>Durum</th>
                        <th>Oluşturulma Tarihi</th>
                        <th style="width: 250px;" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Kayıtlı şablon bulunamadı.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var template in Model)
                        {
                            <tr>
                                <td>@template.Id</td>
                                <td><strong>@template.Title</strong></td>
                                <td>
                                    @if (template.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td>@template.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <form asp-action="ToggleStatus" asp-route-id="@template.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                                            @(template.IsActive ? "Pasife Al" : "Aktife Al")
                                        </button>
                                    </form>
                                    <a asp-action="Edit" asp-route-id="@template.Id" class="btn btn-outline-primary btn-sm ms-1">Düzenle</a>
                                    <form asp-action="Delete" asp-route-id="@template.Id" method="post" class="d-inline ms-1"
                                          onsubmit="return confirm('Bu şablonu silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
