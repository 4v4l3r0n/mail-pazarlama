@model IReadOnlyList<UserDto>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    var currentUserIdClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(currentUserIdClaim, out int currentUserId);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">Sistem Kullanıcıları</h2>
    <span class="badge bg-primary fs-6">Toplam: @Model.Count Kullanıcı</span>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#</th>
                        <th>Ad Soyad</th>
                        <th>E-Posta</th>
                        <th>Kayıt Tarihi</th>
                        <th>Durum</th>
                        <th style="width: 150px;" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Kayıtlı kullanıcı bulunamadı.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>
                                    <strong>@user.FirstName @user.LastName</strong>
                                    @if (user.Id == currentUserId)
                                    {
                                        <span class="badge bg-info text-dark ms-1">Siz</span>
                                    }
                                </td>
                                <td>@user.Email</td>
                                <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Kullanıcı durumunu değiştirmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                @(user.Id == currentUserId ? "disabled" : "")>
                                            @(user.IsActive ? "Pasife Al" : "Aktife Al")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
