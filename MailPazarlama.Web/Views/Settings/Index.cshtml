@model MailSettingDto
@{
    ViewData["Title"] = "Tanım Sayfası";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="card-title mb-0">Tanım Sayfası</h3>
                    @if (Model.UpdatedAt > DateTime.MinValue)
                    {
                        <span class="badge bg-light text-dark border">
                            Son Güncelleme: @Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    }
                </div>

                <form asp-action="Index" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="SmtpServer" class="form-label">SMTP Sunucu Adresi</label>
                            <input asp-for="SmtpServer" class="form-control" placeholder="Örn: smtp.gmail.com" />
                            <span asp-validation-for="SmtpServer" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SmtpPort" class="form-label">Port</label>
                            <input asp-for="SmtpPort" type="number" class="form-control" placeholder="587" />
                            <span asp-validation-for="SmtpPort" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Gönderici E-Posta Adresi</label>
                        <input asp-for="Email" class="form-control" placeholder="bildirim@sirketiniz.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">SMTP Şifresi / Uygulama Parolası</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" value="@Model.Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text">Parolanız AES algoritmasıyla güvenli şekilde şifrelenerek saklanır.</div>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="EnableSsl" class="form-check-input" type="checkbox" id="sslCheck" />
                        <label class="form-check-label" for="sslCheck">
                            SSL / TLS Güvenli Bağlantıyı Etkinleştir
                        </label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
