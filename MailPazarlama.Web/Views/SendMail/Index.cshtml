@model MailPazarlama.Web.Models.SendMailViewModel
@{
    ViewData["Title"] = "Gönderim Sayfası";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h3 class="mb-4">Gönderim Sayfası</h3>

        @if (Model.Subscribers.Count == 0)
        {
            <div class="alert alert-warning">
                Sistemde kayıtlı abone bulunmamaktadır. Gönderim yapabilmek için lütfen önce <a asp-controller="Subscribers" asp-action="Index">Abone Sayfası</a>'ndan abone ekleyiniz.
            </div>
        }
        else if (Model.ActiveTemplates.Count == 0)
        {
            <div class="alert alert-warning">
                Gönderime uygun aktif şablon bulunamadı. Lütfen önce <a asp-controller="Templates" asp-action="Index">Şablon Sayfası</a>'ndan aktif bir şablon oluşturunuz.
            </div>
        }
        else
        {
            <form id="sendMailForm" asp-action="Send" method="post" onsubmit="return validateAndConfirm();">
                
                <!-- 1. Şablon Seçimi Kartı -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <label for="templateId" class="form-label fw-bold">E-Posta Şablonu Seçiniz:</label>
                        <select id="templateId" name="templateId" class="form-select form-select-lg" required>
                            <option value="">-- Şablon Seçiniz --</option>
                            @foreach (var template in Model.ActiveTemplates)
                            {
                                <option value="@template.Id">@template.Title</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- 2. Abone Listesi Kartı (Sadece Onay Kutusu ve Mail Adresi) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-bold">Gönderim Yapılacak Aboneleri Seçiniz</h5>
                        <span class="badge bg-primary">Toplam: @Model.Subscribers.Count Abone</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;" class="text-center">
                                            <input type="checkbox" id="selectAll" class="form-check-input" title="Tümünü Seç / Kaldır" />
                                        </th>
                                        <th>Mail Adresi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var subscriber in Model.Subscribers)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input type="checkbox" name="selectedSubscriberIds" value="@subscriber.Id" class="form-check-input subscriber-checkbox" />
                                            </td>
                                            <td>
                                                <label class="form-check-label w-100" style="cursor: pointer;" onclick="this.closest('tr').querySelector('.subscriber-checkbox').click();">
                                                    @subscriber.Email
                                                </label>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Mail Gönder
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Tümünü seç / kaldır
        document.getElementById('selectAll')?.addEventListener('change', function () {
            const checkboxes = document.querySelectorAll('.subscriber-checkbox');
            checkboxes.forEach(cb => cb.checked = this.checked);
        });

        // Doğrulama ve Onay
        function validateAndConfirm() {
            const templateSelect = document.getElementById('templateId');
            if (!templateSelect.value) {
                alert('Lütfen bir şablon seçiniz.');
                return false;
            }

            const selectedCount = document.querySelectorAll('.subscriber-checkbox:checked').length;
            if (selectedCount === 0) {
                alert('Lütfen gönderim yapılacak en az bir abone seçiniz.');
                return false;
            }

            return confirm('Gönderim yapmak istediğinize emin misiniz?');
        }
    </script>
}
