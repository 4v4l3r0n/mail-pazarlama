@model MailPazarlama.Web.Models.SendMailViewModel
@{
    ViewData["Title"] = "Toplu E-Posta Gönderimi";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="h3 mb-4">Toplu E-Posta Gönderimi</h2>

        <!-- Abone Bilgi Kartı -->
        <div class="card shadow-sm border-0 mb-4 bg-light">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-1">Mevcut Abone Havuzu</h5>
                    <p class="text-muted mb-0 small">E-postanız sistemde kayıtlı olan tüm abonelere tek tek gönderilecektir.</p>
                </div>
                <div>
                    <span class="badge bg-primary fs-5 px-3 py-2">@Model.SubscriberCount Abone</span>
                </div>
            </div>
        </div>

        <!-- Gönderim Formu Kartı -->
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title mb-3">Gönderim Parametreleri</h5>

                @if (Model.SubscriberCount == 0)
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        <strong>Dikkat:</strong> Sistemde kayıtlı abone bulunmamaktadır. Gönderim yapabilmek için lütfen önce <a asp-controller="Subscribers" asp-action="Index" class="alert-link">Abone Yönetimi</a> sayfasından abone ekleyiniz.
                    </div>
                }
                else if (Model.ActiveTemplates.Count == 0)
                {
                    <div class="alert alert-warning mb-0" role="alert">
                        <strong>Dikkat:</strong> Gönderime uygun aktif şablon bulunamadı. Lütfen önce <a asp-controller="Templates" asp-action="Index" class="alert-link">Şablon Yönetimi</a> sayfasından aktif bir şablon oluşturunuz veya mevcut şablonu aktifleştiriniz.
                    </div>
                }
                else
                {
                    <form asp-action="Send" method="post" onsubmit="return confirm('Seçilen şablon @Model.SubscriberCount aboneye gönderilmek üzere sıraya alınacaktır. Onaylıyor musunuz?');">
                        <div class="mb-4">
                            <label for="templateId" class="form-label fw-bold">E-Posta Şablonu Seçiniz (Yalnızca Aktif Şablonlar):</label>
                            <select id="templateId" name="templateId" class="form-select form-select-lg" required>
                                <option value="">-- Şablon Seçiniz --</option>
                                @foreach (var template in Model.ActiveTemplates)
                                {
                                    <option value="@template.Id">@template.Title (Oluşturulma: @template.CreatedAt.ToString("dd.MM.yyyy"))</option>
                                }
                            </select>
                            <div class="form-text">Yalnızca "Aktif" durumdaki şablonlar bu listede listelenmektedir.</div>
                        </div>

                        <div class="alert alert-info small" role="alert">
                            <strong>Bilgilendirme:</strong> Gönderim işlemi asenkron olarak arka planda çalıştırılacaktır. Her bir abonenin gönderim durumunu ("Başarılı" / "Başarısız") anlık olarak <a asp-controller="Reports" asp-action="Index" class="alert-link">Raporlar</a> ekranından takip edebilirsiniz.
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Gönderimi Başlat
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
