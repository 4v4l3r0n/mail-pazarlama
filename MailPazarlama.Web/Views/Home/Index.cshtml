@model SubscriberCreateDto
@{
    ViewData["Title"] = "Bültenimize Abone Olun";
}

<div class="row align-items-center py-4 my-2">
    <div class="col-md-6 pe-lg-4">
        <h2 class="fw-bold mb-2">Mail Pazarlama Uygulaması</h2>
        <p class="text-muted mb-4 fs-6">
            Abonelerinize toplu e-posta gönderin, duyuru ve kampanyalarınızı kolayca yönetin.
        </p>

        <div class="card p-3 bg-light border" style="max-width: 430px;">
            <h5 class="mb-3">Bültene Abone Ol</h5>
            <form asp-action="Index" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-muted small">E-Posta Adresi</label>
                    <input asp-for="Email" class="form-control" placeholder="ornek@alanadi.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary px-4">Abone Ol</button>
            </form>
        </div>
    </div>
    <div class="col-md-6 text-center ps-lg-4">
        <img src="~/images/hero.jpg" alt="Mail Pazarlama" class="img-fluid rounded shadow-sm" style="max-height: 360px;" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
