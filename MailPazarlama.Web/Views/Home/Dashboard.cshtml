@model MailPazarlama.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Başlık ve Karşılama Bölümü -->
<div class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold mb-1">Ana Sayfa</h2>
        <p class="text-muted mb-0">Hoş geldiniz, <strong>@Model.UserName</strong></p>
    </div>
    <div>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-primary me-2">Profil</a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-danger">
                Güvenli Çıkış
            </button>
        </form>
    </div>
</div>

<!-- 3 Adet İstatistik Kartı -->
<div class="row g-4 mb-4">
    <!-- 1. Kayıtlı Abone Sayısı -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Abone Havuzu</span>
                    <h3 class="display-6 fw-bold text-primary my-2">@Model.SubscriberCount</h3>
                    <p class="text-muted small mb-3">Sistemde kayıtlı toplam aktif abone sayısı.</p>
                </div>
                <a asp-controller="Subscribers" asp-action="Index" class="btn btn-outline-primary btn-sm w-100">
                    Abonelere Git &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- 2. Kayıtlı Şablon Sayısı -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">E-Posta Şablonları</span>
                    <h3 class="display-6 fw-bold text-success my-2">@Model.TemplateCount</h3>
                    <p class="text-muted small mb-3">Gönderime hazır veya kayıtlı şablon sayısı.</p>
                </div>
                <a asp-controller="Templates" asp-action="Index" class="btn btn-outline-success btn-sm w-100">
                    Şablonlara Git &rarr;
                </a>
            </div>
        </div>
    </div>

    <!-- 3. Yapılan Mail Gönderimi -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-between p-4">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Toplam Gönderim</span>
                    <h3 class="display-6 fw-bold text-info my-2">@Model.SentMailCount</h3>
                    <p class="text-muted small mb-3">Abonelere iletilen toplam e-posta günlüğü.</p>
                </div>
                <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-info btn-sm w-100">
                    Raporlara Git &rarr;
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Hızlı İşlemler Bölümü (Doküman Madde 2.4 ve 2.5 İle Birebir Uyumlu) -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold">Hızlı İşlemler & Modüller</h5>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-4 col-sm-6">
                <a asp-controller="Subscribers" asp-action="Index" class="btn btn-light border w-100 p-3 text-start text-decoration-none">
                    <div class="fw-bold text-dark">Abone Sayfası</div>
                    <div class="text-muted small">Abone listesini görüntüle ve yeni abone ekle</div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a asp-controller="Templates" asp-action="Index" class="btn btn-light border w-100 p-3 text-start text-decoration-none">
                    <div class="fw-bold text-dark">Şablon Sayfası</div>
                    <div class="text-muted small">E-posta şablonlarını yönet ve düzenle</div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a asp-controller="SendMail" asp-action="Index" class="btn btn-light border w-100 p-3 text-start text-decoration-none">
                    <div class="fw-bold text-primary">Gönderim Sayfası</div>
                    <div class="text-muted small">Toplu e-posta gönderimi başlat</div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a asp-controller="Reports" asp-action="Index" class="btn btn-light border w-100 p-3 text-start text-decoration-none">
                    <div class="fw-bold text-dark">Raporlama Sayfası</div>
                    <div class="text-muted small">Gönderim loglarını ve durumlarını filtrele</div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a asp-controller="Settings" asp-action="Index" class="btn btn-light border w-100 p-3 text-start text-decoration-none">
                    <div class="fw-bold text-dark">Tanım Sayfası</div>
                    <div class="text-muted small">SMTP sunucu ve bağlantı parametreleri</div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a asp-controller="Users" asp-action="Index" class="btn btn-light border w-100 p-3 text-start text-decoration-none">
                    <div class="fw-bold text-dark">Kullanıcılar</div>
                    <div class="text-muted small">Sistem kullanıcılarını görüntüle ve yönet</div>
                </a>
            </div>
            <div class="col-md-4 col-sm-6">
                <a asp-controller="Profile" asp-action="Index" class="btn btn-light border w-100 p-3 text-start text-decoration-none">
                    <div class="fw-bold text-dark">Profil Sayfası</div>
                    <div class="text-muted small">Profil ve parola bilgilerinizi güncelleyin</div>
                </a>
            </div>
        </div>
    </div>
</div>
