@model MailPazarlama.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-3">Parola Hatırlatma</h3>
                <p class="text-muted small text-center mb-4">
                    @(Model.IsEmailVerified ? "E-posta adresiniz doğrulandı. Lütfen yeni parolanızı belirleyiniz." : "Kayıtlı e-posta adresinizi girerek doğrulama işlemini başlatınız.")
                </p>

                <form asp-action="ForgotPassword" method="post">
                    <input type="hidden" asp-for="IsEmailVerified" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    @if (!Model.IsEmailVerified)
                    {
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-Posta Adresi</label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@alanadi.com" autofocus required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" name="action" value="verify" class="btn btn-primary">Doğrula</button>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-Posta Adresi</label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Yeni Parola</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="En az 8 karakter (Büyük, küçük harf ve rakam)" autofocus required />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label">Yeni Parola Tekrar</label>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Yeni parolanızı tekrar giriniz" required />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" name="action" value="reset" class="btn btn-success">Parolayı Güncelle</button>
                        </div>
                    }
                </form>

                <hr class="my-4" />

                <div class="text-center">
                    <a asp-action="Login" class="text-decoration-none small">
                        &larr; Giriş sayfasına dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
