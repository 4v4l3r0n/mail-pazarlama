@model IReadOnlyList<SubscriberDto>
@{
    ViewData["Title"] = "Abone Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">Abone Listesi</h2>
    <span class="badge bg-primary fs-6">Toplam: @Model.Count Abone</span>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Yeni Abone Ekle</h5>
        <form asp-action="Create" method="post" class="row g-3 align-items-center">
            <div class="col-md-9 col-lg-10">
                <input type="email" name="Email" class="form-control" placeholder="E-posta adresi giriniz..." required />
            </div>
            <div class="col-md-3 col-lg-2">
                <button type="submit" class="btn btn-success w-100">Abone Ekle</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">#</th>
                        <th>E-Posta</th>
                        <th>Kayıt Tarihi</th>
                        <th style="width: 120px;" class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Kayıtlı abone bulunamadı.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var subscriber in Model)
                        {
                            <tr>
                                <td>@subscriber.Id</td>
                                <td>@subscriber.Email</td>
                                <td>@subscriber.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <form asp-action="Delete" asp-route-id="@subscriber.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu aboneyi silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
